{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agustinst-code",
  "account_id": "7acb904b4217fca70f8b9d3959141d98",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agustinst-code-db",
      "database_id": "712b37ad-7f6a-4e7a-a08a-f9ade81817f4",
      "migrations_dir": "migrations"
    }
  ]
}
